---
import { MapPin, Network, Search, SlidersHorizontal, Users } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import RelationshipGraph from '../../components/RelationshipGraph.astro';
import {
  characterData,
  characterEntries,
  characterFactions,
  characterRelations,
  characterRoles,
} from '../../data/characters';

const roleOrder = new Map(characterRoles.map((role, index) => [role, index]));
const orderedEntries = [...characterEntries].sort((left, right) =>
  (roleOrder.get(left.role) || 0) - (roleOrder.get(right.role) || 0)
  || right.relationCount - left.relationCount
  || left.name.localeCompare(right.name, 'zh-CN'));
const genderCounts = Object.fromEntries(['男', '女'].map((gender) => [gender, characterEntries.filter((entry) => entry.gender === gender).length]));
---

<BaseLayout title="人物图鉴" description={`收录侠影录当前版本 ${characterData.counts.entries} 位人物，并提供可交互人物关系图。`}>
  <main class="characters-index" data-pagefind-body>
    <ol class="breadcrumbs"><li><a href="/">首页</a></li><li>›</li><li><a href="/entries/">百科目录</a></li><li>›</li><li aria-current="page">人物</li></ol>
    <header class="index-header">
      <div>
        <p class="eyebrow">江湖人物 · {characterData.gameVersion}</p>
        <h1 class="page-heading" data-pagefind-meta="title">人物图鉴</h1>
        <p class="page-lead">查询人物身份、出现地点与剧情关系。重复出现的同名人物已合并，关系图只收录文本中能够明确确认的称谓与立场。</p>
      </div>
      <div class="coverage"><Users size={23} /><strong>{characterData.counts.entries}</strong><span>位人物</span><small>{characterData.counts.portraits} 张立绘 · {characterData.counts.relations} 条明确关系</small></div>
    </header>

    <nav class="view-tabs" aria-label="人物页面视图" data-pagefind-ignore>
      <button class="active" type="button" data-view="catalog"><Users size={19} /><span>人物图鉴</span><small>按身份、势力和地点查询</small></button>
      <button type="button" data-view="relations"><Network size={19} /><span>关系图谱</span><small>拖拽、缩放并查看人物关系</small></button>
    </nav>

    <section class="view-panel catalog-panel" data-view-panel="catalog">
      <div class="role-tabs" role="tablist" aria-label="人物类型" data-pagefind-ignore>
        <button class="active" type="button" data-role=""><span>全部人物</span><b>{characterEntries.length}</b></button>
        {characterRoles.map((role) => <button type="button" data-role={role}><span>{role}</span><b>{characterData.counts.roles[role]}</b></button>)}
      </div>
      <div class="filters" data-pagefind-ignore>
        <label class="query-control"><Search size={18} /><span class="sr-only">搜索人物</span><input id="character-query" type="search" placeholder="搜索姓名、势力或出现地点" autocomplete="off" /></label>
        <label class="select-control"><Users size={15} /><span>性别</span><select id="character-gender"><option value="">全部</option><option value="男">男 · {genderCounts['男']}</option><option value="女">女 · {genderCounts['女']}</option></select></label>
        <label class="select-control"><SlidersHorizontal size={15} /><span>势力</span><select id="character-faction"><option value="">全部势力</option>{characterFactions.map((faction) => <option value={faction}>{faction}</option>)}</select></label>
        <label class="select-control"><MapPin size={15} /><span>排序</span><select id="character-sort"><option value="default">推荐顺序</option><option value="name">姓名</option><option value="relations">关系数量</option><option value="locations">出现地点数</option></select></label>
        <span class="result-count">{characterEntries.length} 条结果</span>
      </div>
      <div class="characters-grid" data-pagefind-ignore>
        {orderedEntries.map((entry, index) => <div
          class="filter-item"
          data-index={index}
          data-search={[entry.name, entry.traditionalName, ...entry.aliases, entry.faction, ...entry.locations, entry.description].join(' ')}
          data-role={entry.role}
          data-gender={entry.gender}
          data-faction={entry.faction}
          data-name={entry.name}
          data-relations={entry.relationCount}
          data-locations={entry.locations.length}
        ><CharacterCard entry={entry} /></div>)}
      </div>
      <div class="empty-state" hidden>没有符合条件的人物。</div>
    </section>

    <section class="view-panel relations-panel" id="relations" data-view-panel="relations" hidden>
      <div class="graph-heading"><div><h2>人物关系图谱</h2><p>线条中间标明关系类型；点击人物查看局部关系，双击进入人物详情。</p></div><span>{characterRelations.length} 条明确关系</span></div>
      <RelationshipGraph entries={characterEntries} relations={characterRelations} />
    </section>
  </main>
</BaseLayout>

<script>
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('.view-tabs button')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-view-panel]')];
  viewButtons.forEach((button) => button.addEventListener('click', () => {
    const view = button.dataset.view || 'catalog';
    viewButtons.forEach((item) => item.classList.toggle('active', item === button));
    panels.forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== view; });
    if (view === 'relations') requestAnimationFrame(() => {
      document.querySelector<HTMLElement>('.relations-panel [data-relationship-graph]')?.dispatchEvent(new Event('relationship-graph:activate'));
      dispatchEvent(new Event('resize'));
    });
  }));
  if (location.hash === '#relations') viewButtons.find((button) => button.dataset.view === 'relations')?.click();

  const queryInput = document.querySelector<HTMLInputElement>('#character-query');
  const genderSelect = document.querySelector<HTMLSelectElement>('#character-gender');
  const factionSelect = document.querySelector<HTMLSelectElement>('#character-faction');
  const sortSelect = document.querySelector<HTMLSelectElement>('#character-sort');
  const roleButtons = [...document.querySelectorAll<HTMLButtonElement>('.role-tabs button')];
  const grid = document.querySelector<HTMLElement>('.characters-grid');
  const items = [...document.querySelectorAll<HTMLElement>('.filter-item')];
  const resultCount = document.querySelector<HTMLElement>('.result-count');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');
  let activeRole = '';

  function applyFilters() {
    const query = queryInput?.value.trim().toLocaleLowerCase('zh-CN') || '';
    const gender = genderSelect?.value || '';
    const faction = factionSelect?.value || '';
    let visible = 0;
    items.forEach((item) => {
      const matches = (!activeRole || item.dataset.role === activeRole)
        && (!gender || item.dataset.gender === gender)
        && (!faction || item.dataset.faction === faction)
        && (!query || item.dataset.search?.toLocaleLowerCase('zh-CN').includes(query));
      item.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) resultCount.textContent = `${visible} 条结果`;
    if (emptyState) emptyState.hidden = visible !== 0;
  }

  function applySort() {
    if (!grid) return;
    const mode = sortSelect?.value || 'default';
    [...items].sort((left, right) => {
      if (mode === 'name') return (left.dataset.name || '').localeCompare(right.dataset.name || '', 'zh-CN');
      if (mode === 'relations') return Number(right.dataset.relations) - Number(left.dataset.relations) || Number(left.dataset.index) - Number(right.dataset.index);
      if (mode === 'locations') return Number(right.dataset.locations) - Number(left.dataset.locations) || Number(left.dataset.index) - Number(right.dataset.index);
      return Number(left.dataset.index) - Number(right.dataset.index);
    }).forEach((item) => grid.append(item));
  }

  roleButtons.forEach((button) => button.addEventListener('click', () => {
    activeRole = button.dataset.role || '';
    roleButtons.forEach((item) => item.classList.toggle('active', item === button));
    applyFilters();
  }));
  [queryInput, genderSelect, factionSelect].forEach((control) => control?.addEventListener('input', applyFilters));
  sortSelect?.addEventListener('input', applySort);
</script>

<style>
  .characters-index { width: min(100%, 1540px); margin: 0 auto; padding: 28px 36px 68px; }
  .index-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; padding-bottom: 24px; }
  .page-lead { max-width: 830px; }
  .coverage { min-width: 245px; display: grid; grid-template-columns: 29px auto 1fr; align-items: baseline; gap: 0 7px; padding: 14px 16px; border-left: 3px solid var(--accent); background: var(--surface); }
  .coverage > :global(svg) { grid-row: 1 / 3; align-self: center; color: var(--accent); }
  .coverage strong { font-size: 1.45rem; line-height: 1; }
  .coverage span { font-size: .82rem; }
  .coverage small { grid-column: 2 / 4; margin-top: 4px; color: var(--text-soft); font-size: .68rem; }
  .view-tabs { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--line); background: var(--surface); }
  .view-tabs button { min-height: 62px; display: grid; grid-template-columns: 24px auto 1fr; align-content: center; align-items: center; gap: 1px 8px; padding: 9px 18px; border: 0; border-right: 1px solid var(--line); border-bottom: 3px solid transparent; background: transparent; color: var(--text-soft); text-align: left; cursor: pointer; }
  .view-tabs button:last-child { border-right: 0; }
  .view-tabs button:hover { background: var(--surface-muted); }
  .view-tabs button.active { border-bottom-color: var(--accent); background: var(--surface-muted); color: var(--text); }
  .view-tabs button > :global(svg) { grid-row: 1 / 3; color: var(--accent); }
  .view-tabs span { font-weight: 800; }
  .view-tabs small { grid-column: 2 / 4; color: var(--text-soft); font-size: .65rem; }
  .view-panel[hidden] { display: none; }
  .role-tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin-top: 14px; border-bottom: 1px solid var(--line-strong); }
  .role-tabs button { min-height: 48px; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 0 8px; border: 0; border-bottom: 3px solid transparent; background: transparent; color: var(--text-soft); cursor: pointer; }
  .role-tabs button.active { border-bottom-color: var(--accent); color: var(--text); }
  .role-tabs b { color: var(--accent); font-size: .68rem; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; padding: 12px; border: 1px solid var(--line); background: var(--surface); }
  .query-control, .select-control { min-height: 40px; display: flex; align-items: center; gap: 8px; padding: 0 11px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); }
  .query-control { min-width: 280px; flex: 1; }
  .query-control > :global(svg), .select-control > :global(svg) { flex: 0 0 auto; color: var(--accent); }
  .select-control > span { color: var(--text-soft); font-size: .72rem; }
  input, select { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); }
  .query-control input { width: 100%; }
  select { cursor: pointer; }
  .result-count { margin-left: auto; color: var(--text-soft); font-size: .78rem; }
  .characters-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
  .filter-item[hidden] { display: none; }
  .empty-state { margin-top: 18px; }
  .relations-panel { margin-top: 22px; }
  .graph-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 12px; }
  .graph-heading h2 { margin: 0; font-size: 1.2rem; }
  .graph-heading p { margin: 5px 0 0; color: var(--text-soft); font-size: .76rem; }
  .graph-heading > span { color: var(--accent); font-size: .76rem; font-weight: 750; }
  @media (max-width: 1380px) { .characters-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .characters-index { padding: 22px 16px 54px; } .index-header { display: block; } .coverage { width: max-content; max-width: 100%; margin-top: 18px; } .query-control { flex-basis: 100%; } .select-control { flex: 1; } .result-count { width: 100%; margin: 0; } }
  @media (max-width: 700px) { .characters-grid { grid-template-columns: 1fr; } .role-tabs button { flex-direction: column; gap: 0; font-size: .72rem; } .view-tabs button { padding-inline: 10px; } .graph-heading { display: block; } .graph-heading > span { display: block; margin-top: 6px; } }
  @media (max-width: 520px) { .select-control { min-width: calc(50% - 5px); } .view-tabs small { display: none; } .view-tabs button { grid-template-columns: 22px 1fr; } .view-tabs button > :global(svg) { grid-row: auto; } .role-tabs b { display: none; } }
</style>
