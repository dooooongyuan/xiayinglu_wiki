---
import { CalendarDays, ExternalLink } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import steamNews from '../../data/steam-news.generated.json';

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="游戏更新公告" description="从 Steam 官方页面同步的侠影录游戏更新公告。">
  <div class="page-wrap updates-page" data-pagefind-body>
    <ol class="breadcrumbs"><li><a href="/">首页</a></li><li>›</li><li aria-current="page">游戏更新公告</li></ol>
    <header class="page-header">
      <div>
        <p class="eyebrow">Steam 官方消息</p>
        <h1 class="page-heading" data-pagefind-meta="title">游戏更新公告</h1>
        <p class="page-lead">汇总《侠影录》的版本更新、问题修复与后续计划。</p>
      </div>
      <a class="button steam-link" href={steamNews.storeUrl} target="_blank" rel="noreferrer">
        Steam 公告页 <ExternalLink size={16} aria-hidden="true" />
      </a>
    </header>

    {steamNews.items.length > 0 ? (
      <div class="news-list">
        {steamNews.items.map((item) => (
          <article class="news-item" id={`news-${item.id}`}>
            <div class="news-meta"><CalendarDays size={15} aria-hidden="true" /><time datetime={item.publishedAt}>{dateFormatter.format(new Date(item.publishedAt))}</time></div>
            <h2><a href={`/updates/${item.id}/`}>{item.title}</a></h2>
            <p>{item.excerpt}</p>
            <div class="news-actions">
              <a class="read-link" href={`/updates/${item.id}/`}>阅读全文</a>
              <a class="news-link" href={item.url} target="_blank" rel="noreferrer">查看 Steam 原文 <ExternalLink size={14} aria-hidden="true" /></a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">公告暂时无法加载，请前往 Steam 公告页查看。</p>
    )}
  </div>
</BaseLayout>

<style>
  .updates-page { max-width: 1040px; }
  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
  .steam-link { flex: 0 0 auto; }
  .news-list { margin-top: 6px; }
  .news-item { padding: 26px 4px 28px; scroll-margin-top: calc(var(--header-h) + 20px); }
  .news-item + .news-item { border-top: 1px solid var(--line); }
  .news-meta { display: flex; align-items: center; gap: 7px; color: var(--text-soft); font-size: .78rem; }
  .news-item h2 { margin: 8px 0 0; font-size: 1.24rem; line-height: 1.42; }
  .news-item h2 a { color: var(--text); text-decoration: none; }
  .news-item h2 a:hover { color: var(--accent); }
  .news-item p { max-width: 820px; margin: 10px 0 0; color: var(--text-soft); font-size: .9rem; line-height: 1.78; }
  .news-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; margin-top: 13px; }
  .read-link, .news-link { display: inline-flex; align-items: center; gap: 6px; font-size: .82rem; font-weight: 650; text-decoration: none; }
  .empty-state { margin-top: 28px; }
  @media (max-width: 700px) {
    .page-header { align-items: flex-start; flex-direction: column; gap: 18px; padding-bottom: 24px; }
    .news-item { padding: 22px 0 24px; }
    .news-item h2 { font-size: 1.08rem; }
  }
</style>
