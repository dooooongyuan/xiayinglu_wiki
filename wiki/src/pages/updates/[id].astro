---
import { CalendarDays, ExternalLink } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import steamNews from '../../data/steam-news.generated.json';

export function getStaticPaths() {
  return steamNews.items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

type NewsItem = (typeof steamNews.items)[number];
interface Props { item: NewsItem }
type Segment = { text: string; href?: string };
type ContentBlock =
  | { type: 'heading' | 'paragraph' | 'rule'; segments: Segment[] }
  | { type: 'list'; items: Segment[][] };

const { item } = Astro.props as Props;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const content: ContentBlock[] = [];
for (const block of item.blocks) {
  const segments = block.segments as Segment[];
  if (block.type === 'item') {
    const previous = content.at(-1);
    if (previous?.type === 'list') previous.items.push(segments);
    else content.push({ type: 'list', items: [segments] });
  } else {
    content.push({ type: block.type as 'heading' | 'paragraph' | 'rule', segments });
  }
}
---

<BaseLayout title={item.title} description={item.excerpt}>
  <article class="page-wrap update-detail" data-pagefind-body>
    <ol class="breadcrumbs"><li><a href="/">首页</a></li><li>›</li><li><a href="/updates/">游戏更新公告</a></li><li>›</li><li aria-current="page">{item.title}</li></ol>
    <header class="detail-header">
      <p class="eyebrow">Steam 官方消息</p>
      <h1 class="page-heading" data-pagefind-meta="title">{item.title}</h1>
      <div class="published"><CalendarDays size={16} aria-hidden="true" /><time datetime={item.publishedAt}>{dateFormatter.format(new Date(item.publishedAt))}</time></div>
    </header>

    {item.images.length > 0 && (
      <div class="news-images">
        {item.images.map((image) => <img src={image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />)}
      </div>
    )}

    <div class="news-body">
      {content.map((block) => {
        if (block.type === 'rule') return <hr />;
        if (block.type === 'heading') return <h2>{block.segments.map((segment) => segment.href ? <a href={segment.href} target="_blank" rel="noreferrer">{segment.text}</a> : segment.text)}</h2>;
        if (block.type === 'list') return <ul>{block.items.map((segments) => <li>{segments.map((segment) => segment.href ? <a href={segment.href} target="_blank" rel="noreferrer">{segment.text}</a> : segment.text)}</li>)}</ul>;
        return <p>{block.segments.map((segment) => segment.href ? <a href={segment.href} target="_blank" rel="noreferrer">{segment.text}</a> : segment.text)}</p>;
      })}
    </div>

    <footer class="detail-footer">
      <a class="button" href="/updates/">返回公告列表</a>
      <a class="button primary steam-source" href={item.url} target="_blank" rel="noreferrer">查看 Steam 原文 <ExternalLink size={16} aria-hidden="true" /></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .update-detail { max-width: 980px; }
  .detail-header { padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .detail-header .page-heading { max-width: 850px; font-size: clamp(2rem, 4vw, 2.8rem); }
  .published { display: flex; align-items: center; gap: 8px; margin-top: 16px; color: var(--text-soft); font-size: .82rem; }
  .news-images { display: grid; gap: 14px; margin: 28px 0; }
  .news-images img { display: block; width: 100%; max-height: 540px; object-fit: contain; background: var(--surface-muted); }
  .news-body { min-width: 0; max-width: 820px; padding-top: 12px; overflow-wrap: anywhere; }
  .news-body h2 { margin: 34px 0 12px; padding-bottom: 9px; border-bottom: 1px solid var(--line); font-size: 1.3rem; line-height: 1.45; }
  .news-body p { margin: 13px 0; color: var(--text); font-size: .95rem; line-height: 1.85; }
  .news-body ul { margin: 12px 0 20px; padding-left: 1.4rem; }
  .news-body li { padding-left: 3px; font-size: .94rem; line-height: 1.78; }
  .news-body li + li { margin-top: 8px; }
  .news-body hr { margin: 32px 0; border: 0; border-top: 1px solid var(--line); }
  .detail-footer { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 42px; padding-top: 22px; border-top: 1px solid var(--line); }
  @media (max-width: 560px) {
    .detail-header .page-heading { font-size: 1.85rem; }
    .news-body h2 { margin-top: 28px; font-size: 1.15rem; }
    .news-body p, .news-body li { font-size: .9rem; }
    .detail-footer .button { flex: 1 1 100%; }
  }
</style>
