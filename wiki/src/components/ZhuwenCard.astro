---
import { ArrowUpRight, Coins, Flame, Layers, Sparkles } from '@lucide/astro';
import type { ZhuwenEntry } from '../data/zhuwen';
import { zhuwenHref, zhuwenKindLabel } from '../data/zhuwen';

interface Props { entry: ZhuwenEntry; }
const { entry } = Astro.props;
const summary = entry.kind === 'fixed'
  ? `${entry.stageCount} 个阶段 · ${entry.valueRange}`
  : entry.kind === 'random'
    ? `${entry.candidateCount} 条候选配置 · ${entry.spellGroups.length} 项武学`
    : entry.candidateCount
      ? `火候 ${entry.heatValue} · 随机 1 条词条`
      : `火候 ${entry.heatValue} · 无随机词条`;
const cost = entry.kind === 'fixed' ? entry.stages.at(-1)?.costMoney || 0 : entry.recipe.costMoney;
---

<article class="zhuwen-card" data-quality={entry.quality}>
  <a class="card-link" href={zhuwenHref(entry)} aria-label={`查看铸纹：${entry.name}`}><span class="sr-only">查看{entry.name}</span></a>
  <div class="icon-frame"><img src={entry.icon} alt="" width="256" height="256" loading="lazy" decoding="async" /></div>
  <div class="card-copy">
    <div class="card-meta"><span>{zhuwenKindLabel(entry)}</span><span class="quality-badge">{entry.qualityLabel}</span></div>
    <div class="card-title"><h3>{entry.name}</h3><ArrowUpRight size={17} /></div>
    <p>{entry.description}</p>
    <div class="effect-line"><Sparkles size={14} /><strong>{summary}</strong></div>
    <div class="card-foot">
      <span><Layers size={14} />{entry.applicableParts.join(' / ')}</span>
      {entry.kind === 'companion' ? <span><Flame size={14} />{entry.unlock.points.toLocaleString('zh-CN')} 修习点</span> : <span><Coins size={14} />最高 {cost.toLocaleString('zh-CN')}</span>}
    </div>
  </div>
</article>

<style>
  .zhuwen-card { position: relative; min-width: 0; min-height: 190px; display: grid; grid-template-columns: 104px minmax(0, 1fr); overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .zhuwen-card:hover { transform: translateY(-2px); border-color: var(--quality-color); box-shadow: var(--shadow); }
  .card-link { position: absolute; z-index: 2; inset: 0; }
  .card-link:focus-visible { outline-offset: -3px; }
  .icon-frame { display: grid; place-items: center; border-right: 3px solid var(--quality-color); background: #111412; }
  .icon-frame img { width: 100%; max-height: 150px; padding: 13px; object-fit: contain; }
  .card-copy { min-width: 0; display: flex; flex-direction: column; padding: 13px 14px 11px; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--accent); font-size: .68rem; font-weight: 750; }
  .quality-badge { flex: 0 0 auto; padding: 1px 6px; border: 1px solid color-mix(in srgb, var(--quality-color) 58%, var(--line)); border-radius: 3px; background: color-mix(in srgb, var(--quality-color) 8%, transparent); color: var(--quality-color); }
  .card-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-top: 4px; }
  h3 { margin: 0; font-size: 1.05rem; line-height: 1.35; }
  p { display: -webkit-box; margin: 5px 0 8px; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--text-soft); font-size: .75rem; line-height: 1.5; }
  .effect-line { display: flex; align-items: center; gap: 6px; margin-top: auto; color: var(--quality-color); font-size: .7rem; }
  .effect-line strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card-foot { display: flex; flex-wrap: wrap; gap: 5px 12px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line); color: var(--text-soft); font-size: .66rem; }
  .card-foot span { display: inline-flex; align-items: center; gap: 4px; }
  @media (max-width: 480px) { .zhuwen-card { grid-template-columns: 90px minmax(0, 1fr); } .icon-frame img { padding: 9px; } .card-copy { padding-inline: 11px; } }
</style>
