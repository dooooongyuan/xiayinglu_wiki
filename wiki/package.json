{
  "name": "xiayinglu-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "assets:optimize": "python ../scripts/optimize_web_assets.py",
    "font:optimize": "python ../scripts/subset_display_font.py",
    "news:update": "node scripts/fetch-steam-news.mjs",
    "prebuild": "npm run news:update",
    "build": "astro check && astro build && pagefind --site dist",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "preview": "astro preview",
    "check": "astro check",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:characters": "node scripts/character-qa.mjs",
    "qa:links": "node scripts/link-qa.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.6.0",
    "@lucide/astro": "^1.28.0",
    "@types/cytoscape": "^3.21.9",
    "astro": "^7.1.3",
    "cytoscape": "^3.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.5.2",
    "parse5": "^7.3.0",
    "playwright-core": "^1.62.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.115.0"
  }
}
